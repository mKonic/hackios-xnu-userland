<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Settings > Accessibility > Display & Text Size > Reduce Transparency: off, the blur materials
	     (dock, folders, Control Center, notification center) are drawn by the host's GPU now
	     (gl=1); with CoreAnimation's software renderer (QEMU_GPU=0) they cost a lot of every frame. -->
	<key>EnhancedBackgroundContrastEnabled</key>
	<false/>
	<!-- Settings > Accessibility > Motion > Reduce Motion: cross-fades instead of zooms and
	     parallax. -->
	<key>ReduceMotionEnabled</key>
	<true/>
</dict>
</plist>
